    "test:ui": "vitest run tests/studioMount.test.tsx --environment jsdom"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "4.1.11",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.1.0"
  }
}
