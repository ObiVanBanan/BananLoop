{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ObiVanBanan/BananLoop/blob/main/benchmarks/agent_capability_v0.2/schemas/result.schema.json",
  "title": "BananLoop Agent Capability Trial Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "role_identity",
    "agent_identity",
    "evaluator_identity",
    "status",
    "metric_results",
    "resource_usage",
    "policy_violations",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "role_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "role_version",
        "registry_version",
        "registry_sha256",
        "team_manifest_sha256",
        "output_contract_sha256",
        "capability_profile_sha256",
        "role_definition_sha256"
      ],
      "properties": {
        "role_id": {
          "type": "string"
        },
        "role_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "Legacy display label; the canonical v0.2 RoleDefinitionV1 has no standalone role_version field."
        },
        "registry_version": {
          "type": "string"
        },
        "registry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "team_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "capability_profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "role_definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Canonical content hash of the pinned RoleDefinitionV1 (not an unverified display version)."
        }
      }
    },
    "agent_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id",
        "model_revision",
        "prompt_sha256",
        "adapter_version"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "model_revision": {
          "type": "string"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "adapter_version": {
          "type": "string"
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evaluator_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_id",
        "version",
        "sha256",
        "receipt_sha256"
      ],
      "properties": {
        "evaluator_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "AGENT_ERROR",
        "EVALUATOR_ERROR",
        "INFRA_ERROR",
        "POLICY_VIOLATION",
        "DISQUALIFIED",
        "INCOMPLETE"
      ]
    },
    "metric_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "value",
          "direction",
          "source"
        ],
        "properties": {
          "metric_id": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "maximize",
              "minimize",
              "target"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "evaluator",
              "human_adjudication",
              "derived"
            ]
          },
          "normalized_value": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cached_tokens",
        "agent_calls",
        "tool_calls",
        "evaluator_calls",
        "wall_clock_seconds",
        "cost_usd",
        "cost_status"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "agent_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "evaluator_calls": {
          "type": "integer",
          "minimum": 0
        },
        "wall_clock_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_status": {
          "type": "string",
          "enum": [
            "KNOWN",
            "UNKNOWN",
            "NOT_METERED",
            "NOT_APPLICABLE"
          ]
        }
      }
    },
    "policy_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "LOW",
              "HIGH",
              "CRITICAL"
            ]
          },
          "evidence_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "artifact_sha256": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "failure_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    }
  },
  "description": "Public design schema for role-capability results; not an RPDI-14 scored report envelope."
}
