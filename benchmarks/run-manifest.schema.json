{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bananloop.dev/schemas/run-manifest.schema.json",
  "title": "BananLoop reproducible run manifest",
  "type": "object",
  "required": ["schema_version", "experiment_id", "status", "source_checkout", "task", "portfolio", "arms", "selector_implementation_sha256", "replicate_design", "container_runtime", "stop_rules"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "source_checkout": {"type": "object", "required": ["revision"], "properties": {"revision": {"$ref": "#/$defs/sha"}}, "additionalProperties": true},
    "task": {"type": "object", "required": ["id", "version", "input_sha256"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "input_sha256": {"type": "object", "required": ["TASK.md", "evaluator.py"], "minProperties": 2, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}, "additionalProperties": true},
    "portfolio": {"type": "object", "required": ["sha256"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": true},
    "arms": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "selector", "mode"], "properties": {"id": {"type": "string"}, "selector": {"type": "string"}, "mode": {"type": "string"}, "model": {"type": "string"}, "reasoning_effort": {"type": "string"}}, "additionalProperties": true, "allOf": [{"if": {"properties": {"mode": {"const": "llm"}}, "required": ["mode"]}, "then": {"required": ["model"]}}]}},
    "selector_implementation_sha256": {"$ref": "#/$defs/hashMap"},
    "replicate_design": {"type": "object", "required": ["paired_seeds", "randomization_seed", "codex_cli_version", "python_version", "codex_exec_args"], "properties": {"paired_seeds": {"type": "array", "items": {"type": "integer"}}, "randomization_seed": {"type": "integer"}, "codex_cli_version": {"type": "string"}, "python_version": {"type": "string"}, "codex_exec_args": {"type": "array", "items": {"type": "string"}}, "agent_profile": {"type": "string"}, "agent_profile_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": true},
    "container_runtime": {"type": "object", "required": ["image_id", "python", "codex_cli"], "properties": {"image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "python": {"type": "string"}, "codex_cli": {"type": "string"}}, "additionalProperties": true},
    "stop_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "hashMap": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
  "additionalProperties": true
}
